    {
      "name": "Apply",
      "kind": "button",
      "refersTo": "button-apply",
      "description": "提交自选时间草稿。",
      "html": "<button class=\"ds-apply\">应用</button>",
      "css": ".ds-apply{font-family:var(--default-font-family,\"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",sans-serif);color:var(--cq-ink,#21201c);font-variant-numeric:tabular-nums;font-size:10.5px;min-width:72px;min-height:23px;padding:4px 8px;border:0;border-radius:6px;background:var(--cq-ink,#21201c);color:var(--cq-solid,#f9f9f8);cursor:pointer;} .ds-apply:hover{background:color-mix(in srgb,var(--cq-ink,#21201c) 88%,var(--cq-solid,#f9f9f8));} .ds-apply:active{opacity:.8;} .ds-apply:focus-visible{outline:2px solid var(--cq-ink,#21201c);outline-offset:2px;}"
    },
    {
      "name": "Settings button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "标题行中的低频操作入口。",
      "html": "<button class=\"ds-settings\" aria-label=\"设置\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z\"/><path d=\"m9 3-1 3-3 1-2 5 2 5 3 1 1 3h6l1-3 3-1 2-5-2-5-3-1-1-3Z\"/></svg></button>",
      "css": ".ds-settings{font-family:var(--default-font-family,\"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",sans-serif);color:var(--cq-ink,#21201c);font-variant-numeric:tabular-nums;display:grid;place-items:center;width:22px;height:22px;padding:4px;border:0;border-radius:6px;background:transparent;color:var(--cq-muted,#63635e);cursor:pointer;} .ds-settings:hover{background:var(--cq-s4,#e9e8e6);} .ds-settings:active{background:var(--cq-s5,#e2e1de);} .ds-settings:focus-visible{outline:2px solid var(--cq-ink,#21201c);outline-offset:2px;}"
    },
    {
      "name": "Time periods",
      "kind": "nav",
      "refersTo": "period-track",
      "description": "三格时间选项与持久中性滑块。",
      "html": "<nav class=\"ds-periods\" aria-label=\"时间范围\"><i class=\"ds-period-marker\" aria-hidden=\"true\"></i><button aria-pressed=\"true\">今日</button><button aria-pressed=\"false\">本周</button><button aria-pressed=\"false\">自选</button></nav>",
      "css": ".ds-periods{font-family:var(--default-font-family,\"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",sans-serif);color:var(--cq-ink,#21201c);font-variant-numeric:tabular-nums;position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));width:236px;padding:2px;border-radius:8px;background:var(--cq-s3,#f1f0ef);} .ds-period-marker{position:absolute;top:2px;bottom:2px;left:2px;width:calc((100% - 4px)/3);border-radius:6px;background:var(--cq-solid,#f9f9f8);box-shadow:0 1px 2px #0000001f;pointer-events:none;} .ds-periods button{position:relative;border:0;border-radius:6px;height:24px;background:transparent;color:var(--cq-muted,#63635e);font:inherit;font-size:11.5px;cursor:pointer;} .ds-periods button[aria-pressed=true]{color:var(--cq-ink,#21201c);font-weight:600;} .ds-periods button:hover{background:var(--cq-s4,#e9e8e6);} .ds-periods button:active{background:var(--cq-s5,#e2e1de);} .ds-periods button:focus-visible{outline:2px solid var(--cq-ink,#21201c);outline-offset:2px;}"
    },
